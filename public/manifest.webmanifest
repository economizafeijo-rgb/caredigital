{
  "name": "NextVita — Saúde, bem-estar e loja",
  "short_name": "NextVita",
  "description": "Medicações, hidratação, alimentação, treinos, sono, peso e loja virtual em um só app. Gratuito.",
  "id": "/",
  "start_url": "/cliente",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#071a1d",
  "theme_color": "#0e8a6a",
  "lang": "pt-BR",
  "categories": [
    "health",
    "fitness",
    "lifestyle",
    "shopping"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
